# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (VPS Docker)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=postgresql://postgres:your_strong_password@vps-ip-or-domain:5432/ragnarok_db

# Redis Cache & Pub/Sub (VPS Docker)
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:your_redis_password@vps-ip-or-domain:6379
