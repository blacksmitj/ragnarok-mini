# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (VPS Docker)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=postgresql://postgres:your_strong_password@vps-ip-or-domain:5432/ragnarok_db

# Redis Cache & Pub/Sub (VPS Docker)
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:your_redis_password@vps-ip-or-domain:6379


# S3 / RustFS Storage Configuration
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="rustfs_admin"
S3_SECRET_KEY="rustfs_password"
S3_BUCKET_NAME="ragnarok-assets"
S3_PUBLIC_URL="http://127.0.0.1:9000/ragnarok-assets"
S3_FORCE_PATH_STYLE="true"

# Admin Dummy Auth Token
ADMIN_DUMMY_TOKEN="admin-dev-secret-token"
